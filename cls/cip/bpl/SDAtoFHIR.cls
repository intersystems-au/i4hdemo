/// This class subclasses the default FHIR Transaction Bundle creation class, by post-process handling it.
/// Just prior to sending the auto-generated byundle to the target, this process will
/// 1. evaluate a searchQuery string to add the the url: of every resource, and change the method from POST to PUT, forcing a conditional update.
/// 2. record in ^||mapRefs, and remove the default fullURL references generated for all entries changed by 1,
/// 3. do a deep-dive scan over all resources that have a reference to the removed fullURL, and, replace these as conditional references.
Class cip.bpl.SDAtoFHIR Extends (HS.FHIR.DTL.Util.HC.SDA3.FHIR.Process, cip.util.FHIRSearchString)
{

Parameter SETTINGS = "TargetConfigName:Basic:selector?context={Ens.ContextSearch/ProductionItems?targets=1&productionName=@productionId},-FHIRVersion,TransmissionMode,FullTransactionResponse,FHIRFormat,FormatFHIROutput,CallbackClass,-ValidResourceRequired,OutputToQuickStream,TransformClass::selector?context={HS.HC.Util.ContextSearch/SubclassOf?class=HS.FHIR.DTL.Util.API.Transform.SDA3ToFHIR},FHIRMetadataSet::selector?context={HS.FHIRServer.Util.ContextSearch/FHIRMetadataSets},FHIREndpoint::selector?context={HS.FHIRServer.Util.ContextSearch/FHIRServerEndpoints}, CustomSDAtoFHIRDTLPackage";

Property CustomSDAtoFHIRDTLPackage As %String;

/// For a given Bundle or Bundle entry, create an HS.Message.FHIR.Request object
/// and forward it to ..TargetConfigName.
Method CreateAndSendFHIRMessage(pFHIRObj As %Library.DynamicObject, pSchema As HS.FHIRServer.Schema, pLocalHostAndPort As %String, pContentType As %String, pFormatter As %JSON.Formatter, pIndentChars As %String, pLineTerminator As %String, pSessionApplication As %String, pSessionId As %String)
{
	set tSC=..ConditionalUpdate(.pFHIRObj)
	set tSC=..ConvertCollectionBundle(.pFHIRObj, $LISTBUILD("Patient","Practitioner","Encounter"))
	do ..FHIRValidate(.pFHIRObj)
	set tSC=##super(pFHIRObj,pSchema,pLocalHostAndPort,pContentType,pFormatter,pIndentChars,pLineTerminator, pSessionApplication, pSessionId)
	quit tSC
}

/// For a given Bundle or Bundle entry, create an HS.FHIRServer.Interop.Request object
/// and forward it to ..TargetConfigName.
Method CreateAndSendInteropMessage(pFHIRObj As %Library.DynamicObject, pSchema As HS.FHIRServer.Schema, pContentType As %String, pFormatter As %JSON.Formatter, pIndentChars As %String, pLineTerminator As %String, pSessionApplication As %String, pSessionId As %String)
{
	set tSC=..ConditionalUpdate(.pFHIRObj)
	set tSC=..ConvertCollectionBundle(.pFHIRObj, $LISTBUILD("Patient","Practitioner","Encounter"))
	do ..FHIRValidate(.pFHIRObj)
	set tSC=##super(pFHIRObj, pSchema, pContentType, pFormatter, pIndentChars, pLineTerminator, pSessionApplication, pSessionId)
	quit tSC
}

ClassMethod FHIRValidate(bundle As %Library.DynamicObject) As %Status
{
	; Validate that the CustomSDAtoFHIRDTLPackage is set and exists
	set schema = ##class(HS.FHIRServer.Schema).LoadSchema("R4")
	set resourceValidator = ##class(HS.FHIRServer.Util.ResourceValidator).%New(schema)
	do resourceValidator.ValidateResource(bundle)
	quit $$$OK
}

ClassMethod ConvertCollectionBundle(bundle As %Library.DynamicObject, keepResourceList As %List) As %Status
{
	set tSC=$$$OK
	set bundle.type = "collection"
	try { 
        for entry=0:1:(bundle.entry.%Size()-1) {
			set resource=bundle.entry.%Get(entry).resource
            continue:'$IsObject(resource) 
			if $listfind(keepResourceList, resource.resourceType) = 0 {
				do bundle.entry.%Remove(entry)
				set entry=entry-1
			}
			else {
				do bundle.entry.%Get(entry).%Remove("request")
				set fullurl =  bundle.entry.%Get(entry).fullUrl
				set bundle.entry.%Get(entry).fullUrl = "urn:uuid:"_fullurl
			}
		}
	} catch ex {
		set tSC=ex.AsStatus()
	}

	quit tSC
}

ClassMethod ConditionalUpdate(bundle As %DynamicObject) As %Status
{
 	set tSC=$$$OK
	set jsonAddEntries=[]

	k ^||mapRefs
	try { 
        for entry=0:1:(bundle.entry.%Size()-1) {
			set resource=bundle.entry.%Get(entry).resource
            continue:'$IsObject(resource) 

			// if Observation, always POST. As these are linked/referenced by DiagnosticReport, DiagnosticReport
			// will delete ObservationItems previously associated with the same diagnostic report. 
			continue:resource.resourceType="Observation"

            // continue of no method exists for building the ifNoneExist header
            if '##class(%Dictionary.CompiledMethod).%ExistsId(..%ClassName(1)_"||"_resource.resourceType) {
				$$$LOGWARNING("Logic for resolving business identifier(s) for resource type: "_resource.resourceType_", is NOT Implemented")
				continue
			}

			/// Get Condition for update  (DiagnosticReport added ObservationItem DELETE entries)
			set qrySearch=$METHOD($this,resource.resourceType,resource,bundle,.jsonAddEntries)
			if qrySearch="" {
				$$$LOGWARNING("Skipping Conditional Update changes for resource type: "_resource.resourceType_", which returned empty identifier query string.")
				continue
			}
             
			/// Modify bundle
			//$$$ThrowOnError(..UpdateBundle(qrySearch,resource,entry,.bundle))
        }


		; change bundle which had internal references to internal bundle URL with uuid's, into ConditionalReferences.
		DO ..ConditionalUpdateUpdateAllRefs(bundle)
		set %obj=bundle
		set path=""
		for  {
			set path=$order(^||mapRefs(1,path),1,newValue) quit:path=""
			if newValue'="" x ("set %"_path_"="""_newValue_"""")
		}

		; incorporate any additional entries generated from this processing (such as resource Deletes of observtion items)
		for entry=0:1:(jsonAddEntries.%Size()-1) {
			set addNew=jsonAddEntries.%Get(entry)
			do bundle.entry.%Push(addNew)
		}

	}
	catch ex {
        set tSC=ex.AsStatus()
		$$$LOGERROR("ERROR Raised when attempting to resolve logical identifiers: "_$System.Status.GetErrorText(ex.AsStatus()))
	}
	quit tSC
}

/// change POST to PUT (Conditional Update)
ClassMethod UpdateBundle(qrySearch, resource, entry, bundle) As %Status
{
	set tSC=$$$OK
	try {
            
		$$$TRACE(resource.resourceType_" url query = "_qrySearch)

		set fullUrl=bundle.entry.%Get(entry).fullUrl

		// Edit POST conditional update entry
		set bundle.entry.%Get(entry).request.method="PUT"
		set bundle.entry.%Get(entry).request.url=resource.resourceType_"?"_qrySearch 
		
		;remove fullUrl element, and update reference map, used later, to replace where this is refenced from other bundle entries.
		do bundle.entry.%Get(entry).%Remove("fullUrl")
		set ^||mapRefs(0,fullUrl)=bundle.entry.%Get(entry).request.url

		if resource.resourceType="Patient" {
			set ^||mapRefs(0,"urn:uuid:"_$p(fullUrl,"/",2,*))=bundle.entry.%Get(entry).request.url
			do bundle.entry.%Get(entry).resource.remove("id")
		}
 
	} catch ex {
		set tSC=ex.AsStatus()
	}

	quit tSC
}

ClassMethod ConditionalUpdateUpdateAllRefs(obj As %DynamicAbstractObject, path = "obj")
{
 
		#dim iterator As %Iterator.Array
		set iterator = obj.%GetIterator()
		
		while iterator.%GetNext(.key, .value) {
			set type = obj.%GetTypeOf(key) 

			if $classname(obj) = "%Library.DynamicArray" {
				set newPath = path _ ".%Get(" _ key _ ")"
			} else {
				if $zname(key, 6) = 1 {
					set newPath =  path _  "." _ key
				} else {
					set newPath =  path _  ".""" _ key _ """"
				}
			}

			// object 
			if $isObject(value) {
				do ..ConditionalUpdateUpdateAllRefs(value,  newPath )
			} else {
				if key="reference" {
					if $d(^||mapRefs(0,value)) set ^||mapRefs(1,newPath)=^||mapRefs(0,value)
				}
			}
		}
}

ClassMethod SearchRepository(resourceType As %String, QueryString As %String) As %DynamicObject
{
	set resourceID=""
	
	; this DTL queries an endpoint to lookup *existing* resourceID based on resources that are about to be created.
	; if not called as part of a Business Process without the FHIREndpoint defined, then, then default to POST methods (create new resources) in the bundle
	quit:'$d(%Ensemble("%Process")) ""
	
	set FHIREndpoint=%Ensemble("%Process").FHIREndpoint
	if FHIREndpoint=""{
		$$$ThrowStatus($$$ERROR($$$GeneralError,"SearchRepository failed. Unable to retrieve FHIR Endpoint"))
	}
	
	Set clientObj = ##class(HS.FHIRServer.RestClient.FHIRService).CreateInstance(FHIREndpoint)
	Do clientObj.SetResponseFormat("JSON")
	Set rp = clientObj.Search("GET", resourceType,,, QueryString)

	if rp.Status'=200 {
		$$$ThrowStatus($$$ERROR($$$GeneralError,"SearchRepository: "_resourceType_"?"_QueryString_". Failed: "_rp.Json.%ToJSON()))
	}

	quit rp.Json
}

Method OnInit() As %Status
{
	// Set the CustomSDAtoFHIRDTLPackage if it is defined in the settings.
	set currentPackage=##class(HS.FHIR.DTL.Util.API.ExecDefinition).GetCustomDTLPackage()
	if ((currentPackage="") || (currentPackage'=..CustomSDAtoFHIRDTLPackage)) && (..CustomSDAtoFHIRDTLPackage'="") {
		set tSC=##class(HS.FHIR.DTL.Util.API.ExecDefinition).SetCustomDTLPackage(..CustomSDAtoFHIRDTLPackage)
		if $$$ISERR(tSC) {
			Return $$$ERROR($$$GeneralError, "Failed to set CustomSDAtoFHIRDTLPackage: "_..CustomSDAtoFHIRDTLPackage)
		}
	}

	return ##super()
}

Storage Default
{
<Data name="SDAtoFHIRDefaultData">
<Subscript>"SDAtoFHIR"</Subscript>
<Value name="1">
<Value>CustomSDAtoFHIRDTLPackage</Value>
</Value>
</Data>
<DefaultData>SDAtoFHIRDefaultData</DefaultData>
<Type>%Storage.Persistent</Type>
}

}
